# face-anonymizer 설정 예시
#
#   cp .env.example .env      하고 필요한 줄만 고친다
#
# 규칙 두 가지.
#   1. 실제 환경 변수가 이긴다. 이 파일은 비어 있는 자리만 채운다.
#      한 번만 다르게 돌려 보고 싶으면 FA_CRF=19 uvicorn ... 처럼 앞에 붙인다.
#   2. 파일이 없어도 된다. 전부 아래 기본값으로 돈다.
#
# .env 는 커밋하지 않는다(.gitignore). 이 예시 파일만 저장소에 남는다.


# ── 저장소 ───────────────────────────────────────────────────────────────────
# 어디에 붙을지. s3 | ncp | s3compat | (gcs · azure 는 아직 지원 안 함)
#
#   s3        AWS S3. 엔드포인트를 안 줘도 리전으로 정해진다
#   ncp       네이버 클라우드 Object Storage. 엔드포인트·리전이 자동으로 채워진다
#   s3compat  Cloudflare R2 · MinIO · Wasabi 등. FA_S3_ENDPOINT 를 직접 넣는다
#
# 셋 다 **S3 API 를 그대로 쓴다** — 코드가 아니라 주소만 다르다.
#FA_STORAGE_PROVIDER=s3
#FA_S3_ENDPOINT=              # 비우면 제공자 기본값. 리전이 다르면 여기 직접

# 아예 다른 저장소를 직접 꽂을 때. storage/base.py 의 계약만 지키면 된다 —
# 우리 코드를 고칠 필요도, 이 레포를 포크할 필요도 없다.
#FA_STORAGE_STORE=내모듈:내클래스

# 아무것도 안 정해진 첫 실행에는 **화면에서** 고를 수 있다(현황 > 저장소).
# 정하고 나면 잠긴다 — 이 API 에는 인증이 없어서, 공인 IP 에 띄워 두면 서버에
# 닿는 누구나 저장소를 갈아치울 수 있기 때문이다. 정한 값은
# <FA_JOBS_DIR>/_storage.json 에 남고(비밀은 안 들어간다) 환경 변수가 이긴다.
# 나중에 화면에서 다시 바꿔야 하면 이걸 켠다.
#FA_ALLOW_STORAGE_EDIT=1

# 버킷을 비워 두면 S3 기능 자체가 꺼지고 직접 업로드만 쓴다.
FA_S3_BUCKET=ax-mbc-label-data-storage
FA_S3_REGION=us-east-1
FA_S3_ROOT_PREFIX=v1/input/
FA_S3_OUTPUT_PREFIX=v1/results/face/
#FA_S3_LIST_TTL=30            # '처리됨' 표시용 목록 캐시(초)
#FA_S3_URL_TTL=3600           # presigned URL 유효 시간(초)
#FA_S3_WEIGHTS_KEY=v1/model/yolo-facev2.pt   # 가중치 위치. 없으면 기동 때 여기서 받는다

# AWS 자격 증명은 여기 넣지 않는 것을 권한다. EC2 인스턴스 역할이나
# ~/.aws/credentials 를 쓰면 파일에 남지 않는다.


# ── 납품 스펙 ────────────────────────────────────────────────────────────────
# 720p / 30fps / 3000~4000 kbps. fps 는 입력을 그대로 따라간다.
FA_OUTPUT_HEIGHT=720          # 짧은 변 상한. 0 이면 원본 해상도 유지
FA_TARGET_BITRATE=3500k       # 비우면 예전 방식(CRF + 원본 비례 상한)
FA_MAX_BITRATE=4000k          # 순간 최대
#FA_CRF=23                    # 목표 비트레이트를 비웠을 때만 쓰인다
#FA_BITRATE_RATIO=1.0         # 위와 같음. 0 이면 상한 없음


# ── 검출 · 처리 기본값 ───────────────────────────────────────────────────────
#FA_METHOD=mosaic             # mosaic | blur | box
#FA_CONF=0.25                 # 검출 임계값. 낮추면 더 잡고 오검출도 는다
#FA_IMGSZ=1280                # 추론 해상도. 작은 얼굴이 많으면 1600
#FA_BATCH_SIZE=32
#FA_PAD=0.15                  # 박스를 얼마나 넓혀 가릴지
#FA_MOSAIC_SCALE=0.06         # 모자이크 블록 크기(박스 대비)
#FA_LINGER=5                  # 검출이 끊긴 뒤 몇 프레임 더 가릴지
#FA_INTERP=1                  # 사라진 구간 보간
#FA_KEEP_AUDIO=1
#FA_DEVICE=                   # cuda:0 | cpu. 비우면 자동
#FA_INGEST_CRF=16             # AV1 등을 H.264 로 옮겨 담을 때의 화질


# ── 서버 운영 ────────────────────────────────────────────────────────────────
#FA_JOBS_DIR=jobs             # 작업 디렉터리
#FA_PRELOAD=1                 # 기동 시 모델 로드. 0 이면 첫 요청 때
#FA_MAX_ATTEMPTS=4            # 처음 1회 + 재시도 3회 (RETRY_DELAYS 와 짝)
#FA_MIN_FREE_MB=2048          # 이보다 여유가 적으면 507 로 거절
#FA_KEEP_LOCAL_RESULT=0       # 1 이면 S3 업로드 뒤에도 로컬 사본을 남긴다
#FA_RECOVER=1                 # 기동 시 중단 작업 복구. --workers N 이면 하나만 켠다
#FA_RETRY_DELAYS=5,30,60      # 재시도 간격. 처음 1회 + 재시도 3회 = 95초 창
#FA_DEFER_SEC=60              # 디스크 부족 등으로 보류할 때 재확인 간격
#FA_DEFER_MAX_SEC=1800        # 보류 상한. 넘으면 실패로 남긴다
#FA_JOB_TTL_MIN=120           # 완료된 작업 보관 시간. 0 이면 안 지움
#FA_FAILED_TTL_MIN=0          # 실패는 기본적으로 안 지운다
#FA_SWEEP_SEC=300             # 정리 주기
#FA_QUEUE_MAX=0               # 대기열 상한. 0 = 무제한
#FA_BATCH_MAX=0               # 한 요청에 넣을 개수 상한. 0 = 무제한
#FA_LIST_LIMIT=100            # API 목록 기본 상한
#FA_MAX_UPLOAD_MB=2048
#FA_RETRY_AFTER=30            # 429/507 응답의 Retry-After(초)
#FA_FFMPEG_TIMEOUT=600
#FA_ENCODER=                  # h264_nvenc | libx264. 비우면 되는 것을 고름
#FA_PAGE_SIZE=5               # 화면 한 쪽에 그리는 카드 수

# ── MSA 워커 (RebornStudio 연동) ─────────────────────────────────────────────
# 잡 페이로드 하나로 도는 컨테이너에서만 쓴다. 단독 운영에는 필요 없다.
# 자세한 내용: docs/integration/rebornstudio.md
#FA_WEIGHTS_SOURCE=s3         # s3 | baked | url  (미결 D1 — 지금은 s3)
#FA_STALL_S=300               # 진행이 이만큼 멎으면 일시 실패로 끊는다
#FA_HTTP_CONNECT_TIMEOUT=30   # 서명된 URL 연결 타임아웃
#FA_HTTP_READ_TIMEOUT=600     # 서명된 URL 읽기/쓰기 타임아웃
#FA_BROKER_URL=                # 저쪽 Redis. 없으면 REDIS_URL 을 본다
#FA_MSA_QUEUE=q.deidentify     # 우리가 구독할 큐
#FA_MSA_TASK=worker_io.tasks.deidentify_one          # 저쪽이 보낼 이름과 같아야 한다
#FA_MSA_CALLBACK_QUEUE=default
#FA_MSA_HEARTBEAT_TASK=worker_io.tasks.deidentify_heartbeat
#FA_MSA_COMPLETE_TASK=worker_io.tasks.deidentify_complete
#FA_MSA_CONCURRENCY=1          # GPU 한 장에 검출기 하나
#FA_MSA_PRELOAD=1              # 기동 때 모델 예열
#FA_MSA_VISIBILITY_TIMEOUT=3600  # Redis 에는 ack 가 없다 — 이 시간이 곧 재배달 시점
#FA_TZ_OFFSET=9               # 로그·화면 시각 표기 오프셋 (기본 한국 +9)
#FA_TZ_LABEL=KST
#FA_HWACCEL=1                 # 입력 디코딩을 GPU(NVDEC)로. 0 이면 CPU

# ── 로그 · 이벤트 저널 ───────────────────────────────────────────────────────
#FA_LOG_LEVEL=INFO            # 이걸 안 잡으면 uvicorn 아래에서 INFO 가 버려진다
#FA_LOG_FILE=                 # 비우면 화면만. 주면 날짜별로 회전한다
#FA_LOG_KEEP_DAYS=14
#FA_REVIEW_TTL_MIN=0         # 검수 대기 보관 기간. 0 = 안 지움 (판정 전에는
                              # 시간으로 지우면 안 된다 — docs/issues/010)
#FA_EVENTS=1                  # 기계가 읽는 JSONL 기록 (GET /api/events)
#FA_EVENTS_DIR=               # 기본 <FA_JOBS_DIR>/_events
#FA_MODE=                     # 저널 줄에 찍히는 얼굴. 비우면 api, msa 워커는 msa
#FA_EVENTS_STDOUT=            # 저널을 stdout 으로도. msa 워커는 자동으로 켠다 —
                              # 컨테이너가 지워지면 파일도 같이 사라지기 때문
